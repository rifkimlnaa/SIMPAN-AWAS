# Salin isi file ini menjadi ".env" di folder htdocs hosting, lalu ganti bagian yang bertanda GANTI.

APP_NAME="SIMPAN-AWAS"
APP_ENV=production
# GANTI: hasil perintah  php artisan key:generate --show  (di komputer sendiri), diawali base64:
APP_KEY=base64:GANTI_DENGAN_KUNCI_ANDA
APP_DEBUG=false
# GANTI: alamat situs Anda, pakai https
APP_URL=https://NAMA-ANDA.rf.gd
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# GANTI: data dari menu MySQL Databases di panel InfinityFree (host BUKAN localhost)
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_arsip
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=GANTI

# InfinityFree tidak punya Redis/Memcached, jadi pakai file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Batas upload arsip (KB). Turunkan jika hosting menolak berkas besar.
ARSIP_MAX_UPLOAD_KB=10240
